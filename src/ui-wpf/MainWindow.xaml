<Window x:Class="EsoLogFilter.Ui.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EsoLogFilter.Ui.Wpf"
        mc:Ignorable="d"
        Title="Eso Log Filter" Height="360" Width="800">
    <Grid Background="Black">
        <Image Margin="0,10,10,0" HorizontalAlignment="Right" Width="237" Height="338" VerticalAlignment="Top" Source="/LowFps.png"/>
        <Label x:Name="lblSourceFile" Content="Source File:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="142" Foreground="White"/>
        <TextBox x:Name="tbSourceFile" Margin="157,14,350,0" Text="" TextWrapping="Wrap" VerticalAlignment="Top" IsEnabled="False" Height="18"/>
        <Button x:Name="btnSourceFile" Content="Select" Margin="0,12,252,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="93" Click="btnSourceFile_Click"/>
        <Label x:Name="lblUnitTypes" Content="Units you want to see in the log:" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top" Foreground="White"/>
        <CheckBox x:Name="cbPlayer" Content="Players" HorizontalAlignment="Left" Margin="29,72,0,0" VerticalAlignment="Top" Width="142" Foreground="White" IsChecked="True"/>
        <CheckBox x:Name="cbMonsterHostile" Content="Monster - Hostile" HorizontalAlignment="Left" Margin="29,92,0,0" VerticalAlignment="Top" Foreground="White"/>
        <CheckBox x:Name="cbMonsterNpcAlly" Content="Monster - Npc Ally (Pet)" HorizontalAlignment="Left" Margin="29,112,0,0" VerticalAlignment="Top" Foreground="White" IsChecked="True"/>
        <CheckBox x:Name="cbMonsterFriendly" Content="Monster - Friendly" HorizontalAlignment="Left" Margin="29,132,0,0" VerticalAlignment="Top" Foreground="White"/>
        <CheckBox x:Name="cbMonsterNeutral" Content="Monster - Neutral" HorizontalAlignment="Left" Margin="29,152,0,0" VerticalAlignment="Top" Foreground="White"/>
        <CheckBox x:Name="cbObject" Content="Object" HorizontalAlignment="Left" Margin="29,172,0,0" VerticalAlignment="Top" Foreground="White"/>
        <CheckBox x:Name="cbSiegeWeapon" Content="Siege weapon" HorizontalAlignment="Left" Margin="29,192,0,0" VerticalAlignment="Top" Foreground="White"/>
        <Label x:Name="lblTargetFile" Content="Target File:" HorizontalAlignment="Left" Margin="10,212,0,0" VerticalAlignment="Top" Foreground="White" Width="142"/>
        <TextBox x:Name="tbTargetFile" Margin="157,216,350,0" Text="" TextWrapping="Wrap" VerticalAlignment="Top" IsEnabled="False" Height="18"/>
        <Button x:Name="btnTargetFile" Content="Select" Margin="0,215,252,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="93" Click="btnTargetFile_Click"/>
        <Button x:Name="btnRun" Content="Run" Margin="10,253,252,0" VerticalAlignment="Top" RenderTransformOrigin="0,0.503" Click="btnRun_Click"/>
        <StackPanel x:Name="pnlLoading" Orientation="Horizontal" Margin="10,253,252,0" VerticalAlignment="Top" Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" Width="120" Height="20" Margin="0,0,10,0"/>
            <Label Content="Working..." Foreground="White" VerticalAlignment="Center" Padding="0"/>
            <Button x:Name="btnCancel" Content="Cancel" Width="60" Margin="10,0,0,0" Click="btnCancel_Click"/>
        </StackPanel>
        <Label x:Name="lblError" Content="" Margin="10,278,252,10" Foreground="Black" Background="White"/>

    </Grid>
</Window>
